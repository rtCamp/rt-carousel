{
  "name": "rt-carousel",
  "version": "2.1.0",
  "description": "Carousel block using Embla and WordPress Interactivity API",
  "author": "rtCamp",
  "private": true,
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rtCamp/rt-carousel"
  },
  "bugs": {
    "url": "https://github.com/rtCamp/rt-carousel/issues"
  },
  "scripts": {
    "build": "wp-scripts build --experimental-modules --webpack-src-dir=./src --output-path=./build",
    "start": "wp-scripts start --experimental-modules --webpack-src-dir=./src --output-path=./build",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "lint:js:types": "tsc --build --noEmit",
    "lint:css": "wp-scripts lint-style",
    "lint:css:fix": "wp-scripts lint-style --fix",
    "lint:php": "composer run-script lint",
    "lint:php:fix": "composer run-script format",
    "changelog": "npx conventional-changelog -p angular -i CHANGELOG.md -s",
    "version": "npm run changelog && git add CHANGELOG.md",
    "i18n:pot": "wp i18n make-pot . languages/rt-carousel.pot --domain=rt-carousel --exclude=node_modules,vendor,tests --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/rtCamp/rt-carousel/issues\"}'",
    "test:actions": "act",
    "test:js": "wp-scripts test-unit-jest",
    "test:js:watch": "wp-scripts test-unit-jest --watch",
    "test:js:coverage": "wp-scripts test-unit-jest --coverage"
  },
  "dependencies": {
    "@wordpress/babel-preset-default": "8.55.0",
    "@wordpress/block-editor": "^15.10.0",
    "@wordpress/blocks": "^15.10.0",
    "@wordpress/components": "^30.0.0",
    "@wordpress/compose": "7.38.0",
    "@wordpress/data": "^10.10.0",
    "@wordpress/dom-ready": "^4.37.0",
    "@wordpress/element": "6.38.0",
    "@wordpress/hooks": "4.41.0",
    "@wordpress/i18n": "^6.10.0",
    "@wordpress/icons": "11.5.0",
    "@wordpress/interactivity": "6.37.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-fade": "8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/wordpress__block-editor": "15.0.0",
    "@types/wordpress__blocks": "12.5.18",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@wordpress/eslint-plugin": "28.0.0",
    "@wordpress/jest-preset-default": "14.2.0",
    "@wordpress/scripts": "37.0.0",
    "babel-jest": "30.5.0",
    "conventional-changelog-angular": "8.3.1",
    "conventional-changelog-cli": "5.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpack-dev-server": ">=5.2.1",
    "serialize-javascript": ">=7.0.3"
  }
}
